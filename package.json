{
  "name": "effect-acp",
  "module": "src/index.ts",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./AcpSchema": "./src/AcpSchema.ts",
    "./AcpError": "./src/AcpError.ts",
    "./AcpProtocol": "./src/AcpProtocol.ts",
    "./AcpTransport": "./src/AcpTransport.ts",
    "./AcpConnector": "./src/AcpConnector.ts",
    "./AcpConnection": "./src/AcpConnection.ts",
    "./protocol/v1": "./src/protocol/v1/Schema.ts",
    "./protocol/v2": "./src/protocol/v2/Schema.ts",
    "./transport/InMemory": "./src/transport/InMemory.ts",
    "./transport/Stdio": "./src/transport/Stdio.ts"
  },
  "scripts": {
    "prepare": "effect-tsgo patch",
    "generate": "bun scripts/codegen/generate.ts",
    "generate:check": "bun scripts/codegen/generate.ts --check",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "check:browser": "bun scripts/check-browser.ts",
    "check": "bun run generate:check && bun run typecheck && bun test && bun run check:browser"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-rc.115",
    "@effect/platform-node": "4.0.0-rc.115",
    "@effect/tsgo": "^0.45.0",
    "@types/bun": "latest",
    "ajv": "^8"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "effect": "4.0.0-rc.115"
  }
}
